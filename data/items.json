  "rollItem_final": "function () {\n      let it = _roll.apply(this, arguments);\n      if (it && (it.q === 'rare' || it.q === 'unique') && Math.random() < 0.30) {\n        for (let k = 0; k < 10; k++) { const r = _roll.apply(this, arguments); if (r && r.q !== 'rare' && r.q !== 'unique') { it = r; break; } }\n      }\n      return it;\n    }",
  "affixPool": "function affixPool(base, ilvl, pre, rare) { return AFFIX.filter(a => a.p === pre && a.l <= ilvl + 1 && (!a.only || a.only.includes(base.slot)) && (!a.rare || rare)); }",
  "newBaseItem": "function newBaseItem(baseId) {\n  const b = BASES[baseId];\n  const it = { uid: itemUid++, base: baseId, q: 'normal', name: b.name, w: b.w, h: b.h, stats: {}, lvl: 1 };\n  if (b.armor) it.armor = randi(b.armor[0], b.armor[1]);\n  if (b.dmg) it.dmg = [b.dmg[0], b.dmg[1]];\n  return it;\n}",
  "dropLoot_final": "function () {\n      const z = G.zone, n0 = z && z.items ? z.items.length : 0, r = fn.apply(this, arguments);\n      try { if (z && z.items && z.items.length > n0) dropSound(z.items.slice(n0)); } catch (e) { }\n      return r;\n    }",
  "potionHeal": "function (amt) { if (aR('v_crown')) { say(crown().name + ' refuses the draught', 1.4); return 0; } return _ph.apply(this, arguments); }"
